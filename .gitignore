firebase-key.json
backend/firebase-key.json

# 3. Build outputs
dist/
build/
frontend/dist/
backend/dist/

# 4. OS Files
.DS_Store
Thumbs.db

# 5. Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*